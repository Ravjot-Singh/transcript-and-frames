API_KEY=

# Optional extra lock: comma-separated IPs/CIDRs allowed to call the service.
#   example: ALLOWED_IPS=203.0.113.7,198.51.100.0/24
ALLOWED_IPS=

# Trust the X-Forwarded-For header when determining the caller's IP.
# Must be true behind Render/Koyeb/any reverse proxy, otherwise every caller
# looks like the proxy. Only set false if the service is directly exposed.
TRUST_PROXY_HEADER=true

# Browser origins allowed by CORS. Empty is correct for this deployment because
# both routes are called server-to-server, not from a browser. Only fill this in
# if you later point a web frontend directly at /v1/translate.
#   example: ALLOWED_ORIGINS=https://yourapp.com,https://staging.yourapp.com
ALLOWED_ORIGINS=

ENABLE_DOCS=true

# NOTE: the value here (true) is a CHOICE, not the code default. app/config.py defaults
# enable_demo to False, so deleting this line makes /demo answer 404 demo_disabled even
# though this file implied it was on.
ENABLE_DEMO=true

LOG_LEVEL=info

DEBUG_ERRORS=false

GROQ_API_KEY=

GROQ_MODEL=whisper-large-v3

GROQ_BASE_URL=https://api.groq.com/openai/v1

CLOUDINARY_API_SECRET=

CLOUDINARY_EXTRA_HOSTS=

ALLOW_FETCH_DELIVERY=false

CLOUDINARY_FORWARD_QUERY_PARAMS=__cld_token__

AUDIO_TRANSFORMATION=af_16000,br_32k
AUDIO_FORMAT=mp3

MAX_AUDIO_BYTES=20971520

SPOOL_THRESHOLD_BYTES=8388608
STREAM_CHUNK_BYTES=65536
MAX_REDIRECTS=3

MAX_CONCURRENT_ASR=3

HTTP_CONNECT_TIMEOUT=5
HTTP_READ_TIMEOUT=120
HTTP_WRITE_TIMEOUT=120
HTTP_POOL_TIMEOUT=5

#   mu = MAX_ALLOWED_DURATION_MIN / 2   (the curve's peak, 5 min by default)
#   sigma = SIGMA_L when d <= mu, else SIGMA_R
# Peak is 60 frames at 5 minutes; a 2-minute video yields 19.
FRAME_A=60.0
FRAME_FMIN=8
FRAME_FMAX=60
MAX_ALLOWED_DURATION_MIN=10.0
SIGMA_L=2.0
SIGMA_R=4.0

TIMESTAMP_SIGMA_DIVISOR=6

FRAME_JPEG_QUALITY=80

FRAME_WIDTH=0

# Cap on frames returned; 0 = no cap. The curve still decides the count and the
# response still reports it as requested_frame_count; timestamps are recomputed for
# the smaller number. A request's own max_frames overrides this.
MAX_FRAMES_DEFAULT=0

FRAME_SINK=url

REJECT_OVER_MAX_DURATION=false

ENABLE_NATIVE_TRANSCRIPT=false
GROQ_NATIVE_MODEL=whisper-large-v3-turbo


# --- used by the live-check scripts, not by the service ------------------------
# scripts/smoke.py and scripts/cloudinary_checks.py read these three from the
# environment, or from this file via their own minimal parser. The service itself
# ignores them, which is why they were missing here.

# A real Cloudinary video URL to run the live checks against.
#   .venv/Scripts/python scripts/cloudinary_checks.py   # Cloudinary only, no ASR quota
#   .venv/Scripts/python scripts/smoke.py               # exactly one Groq request
SMOKE_VIDEO_URL=

# Its duration in seconds; drives how many frames the curve asks for.
SMOKE_VIDEO_DURATION_SEC=

# Which env file app/config.py loads, resolved relative to the CURRENT WORKING
# DIRECTORY. Leave unset to use .env. The test suite sets it to a filename that does
# not exist so a developer's real .env can never leak into a test run.
#
# Practical consequence: start the service FROM THE PROJECT ROOT. Launched from
# elsewhere it silently finds no .env, and /health then reports
# auth_configured: false while every /v1 route answers 503.
CONFIG_ENV_FILE=
